APP_NAME=Monitoring PKL
DEBUG=false
DATABASE_URL=mysql://root:@localhost:3306/absensi
SQL_ECHO=false
# Wajib kuat & unik saat DEBUG=false (aplikasi menolak start bila masih default).
JWT_SECRET_KEY=ganti-dengan-secret-panjang-minimal-48-karakter
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Kunci khusus enkripsi template wajah (terpisah dari JWT secret).
# Isi dengan passphrase acak panjang untuk produksi.
FACE_ENCRYPTION_KEY=
FACE_MAX_FAILED_ATTEMPTS=5
FACE_LOCK_MINUTES=10

# Algoritma verifikasi wajah: cosine-similarity (uji FAR/FRR sebelum diubah).
FACE_VERIFY_THRESHOLD=0.45
FACE_LIVENESS_MIN_LAPLACIAN=15.0

# Registrasi wajah: jumlah sampel minimum & ambang konsistensi antar-sampel.
FACE_REGISTER_MIN_SAMPLES=3
FACE_REGISTER_MAX_SAMPLES=8
FACE_EMBEDDING_CONSISTENCY_MIN=0.5

# Rate limit endpoint biometrik (permintaan per menit) & throttle login persisten.
FACE_RATE_PER_USER_PER_MINUTE=10
FACE_RATE_PER_IP_PER_MINUTE=30
RATE_LIMIT_PERSISTENT=true

# Layanan ML wajah terpisah. Kosongkan FACE_SERVICE_URL untuk menjalankan
# model in-process (khusus development). Isi keduanya untuk produksi.
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=
FACE_SERVICE_TIMEOUT_SECONDS=8
FACE_MAX_IMAGE_BYTES=4000000
FACE_SERVICE_RATE_PER_MINUTE=120
